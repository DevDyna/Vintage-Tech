{
  "multipart": [
    {
      "apply": {
        "model": "vintagetech:block/rope/line"
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/rope/line",
        "x": 180
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/rope/line",
        "x": 90
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/rope/line",
        "x": 90,
        "y": 180
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/rope/line",
        "x": 90,
        "y": 90
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/rope/line",
        "x": 90,
        "y": 270
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/rope/dot"
      },
      "when": {
        "has_corner": "true"
      }
    }
  ]
}