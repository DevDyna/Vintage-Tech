{
  "multipart": [
    {
      "apply": {
        "model": "vintagetech:block/beam/dark_oak",
        "x": 90,
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/beam/dark_oak"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/beam/dark_oak",
        "x": 90
      },
      "when": {
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/rope/on_beam"
      },
      "when": {
        "has_rope": "true"
      }
    }
  ]
}