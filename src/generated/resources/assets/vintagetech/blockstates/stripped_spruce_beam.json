{
  "multipart": [
    {
      "apply": {
        "model": "vintagetech:block/stripped_spruce_beam/core"
      },
      "when": {
        "x": "false",
        "y": "false",
        "z": "false"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/stripped_spruce_beam/pillar"
      },
      "when": {
        "x": "false",
        "y": "true",
        "z": "false"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/stripped_spruce_beam/pillar",
        "x": 90,
        "y": 90
      },
      "when": {
        "x": "true",
        "y": "false",
        "z": "false"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/stripped_spruce_beam/pillar",
        "x": 90
      },
      "when": {
        "x": "false",
        "y": "false",
        "z": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/stripped_spruce_beam/cross"
      },
      "when": {
        "x": "true",
        "y": "true",
        "z": "false"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/stripped_spruce_beam/cross",
        "y": 90
      },
      "when": {
        "x": "false",
        "y": "true",
        "z": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/stripped_spruce_beam/cross",
        "x": 90,
        "y": 90
      },
      "when": {
        "x": "true",
        "y": "false",
        "z": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/stripped_spruce_beam/star"
      },
      "when": {
        "x": "true",
        "y": "true",
        "z": "true"
      }
    },
    {
      "apply": {
        "model": "vintagetech:block/rope/on_beam"
